# Server Configuration
SERVER_ADDRESS="127.0.0.1:8000"

# Database URL for PostgreSQL
# Example: "postgres://user:password@host:port/database"
DATABASE_URL="postgres://postgres:password@localhost:5432/recruitment_db"

# Security
# A long, random string used for signing JWTs
JWT_SECRET="your-super-secret-jwt-key"
# Secret for securing incoming webhooks
WEBHOOK_SECRET="your-webhook-secret"

# External APIs
# Your API key for OpenAI or another AI provider
OPENAI_API_KEY="your-openai-api-key"

# Rate limiting configuration
PUBLIC_RPS=20
INTEGRATION_RPS=10

# AI limits
MAX_AI_QUESTIONS=12

# Logging
# Can be "trace", "debug", "info", "warn", "error"
RUST_LOG="info,recruitment_backend=debug"

# URL for the Telegram bot to send notifications to
TELEGRAM_BOT_WEBHOOK_URL="https://your-telegram-bot.com/webhook"

# WebApp public URL (required for generating CV download links)
WEBAPP_URL="https://your-webapp.com"

# 1F Integration — comma-separated list of OneF base URLs.
# Every notification is fan-out to ALL targets concurrently.
ONEF_BASE_URLS="http://192.168.1.47/app/v1.2/api/publications,http://192.168.1.38/app/v1.2/api/publications"
# Legacy fallback (used if ONEF_BASE_URLS is not set):
# ONEF_WEBHOOK_URL="http://192.168.1.38/app/v1.2/api/publications/action/candidateResponse"

# Single host to READ 1F data from (vacancy catalogue sync).
# ONEF_BASE_URLS is a write fan-out list and only one of its hosts serves
# action/getVacancies — the others answer 404 — so reads use this instead.
# Defaults to the first ONEF_BASE_URLS entry when unset.
ONEF_READ_BASE_URL="http://192.168.1.47/app/v1.2/api/publications"
# How often the 1F vacancy catalogue is refreshed, in seconds (min 30, default 600).
ONEF_VACANCY_SYNC_INTERVAL_SECS=600